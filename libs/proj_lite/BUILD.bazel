load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:genrule.bzl", "hrz_genrule")

py_binary(
    name = "compress_db",
    srcs = ["db/compress_db.py"],
    main = "db/compress_db.py",
    python_version = "PY3",
)

hrz_genrule(
    name = "crs_database.bin",
    srcs = ["db/epsg_proj.sqlite"],
    outs = ["db/crs_database.bin"],
    cmd = "$(location compress_db) $< $@",
    tools = ["compress_db"],
)

hrz_genrule(
    name = "crs_db.c",
    srcs = ["db/crs_database.bin"],
    outs = ["src/crs_database_data.c"],
    cmd = "$(location //tools/bazel/cc_resources:make_resource_source) crs_db_data $< c $@",
    tools = ["//tools/bazel/cc_resources:make_resource_source"],
)

cc_library(
    name = "proj_lite",
    srcs = [
        "include/proj_lite_internal/common.h",
        "include/proj_lite_internal/constants.h",
        "include/proj_lite_internal/crs_database.h",
        "include/proj_lite_internal/database.h",
        "include/proj_lite_internal/projection.h",
        "include/proj_lite_internal/string_span.h",
        "src/crs_database.c",
        "src/crs_database_data.c",
        "src/database.c",
        "src/parse_proj_string.c",
        "src/projection.c",
        "src/projections/geocent.c",
        "src/projections/latlong.c",
        "src/projections/lcc.c",
        "src/projections/merc.c",
        "src/projections/tmerc.c",
        "src/projections/utm.c",
        "src/result.c",
        "src/string_span.c",
        "src/transform.c",
    ],
    hdrs = [
        "include/proj_lite.h",
    ],
    includes = [
        "include",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "tests",
    srcs = [
        "tests/common.h",
        "tests/crs.cpp",
        "tests/crs_common.h",
        "tests/generated.cpp",
    ] + glob(["tests/crs_generated/*.cpp"]),
    deps = [
        ":proj_lite",
        "//third_party:gtest",
        "//third_party:gtest_main",
    ],
)

cc_binary(
    name = "check_crs_support",
    srcs = [
        "tools/check_crs_support.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":proj_lite",
    ],
)

py_binary(
    name = "list_supported_crs",
    srcs = ["tools/list_supported_crs.py"],
    data = [":check_crs_support"],
    main = "tools/list_supported_crs.py",
    python_version = "PY3",
)

hrz_genrule(
    name = "crs_database.csv",
    srcs = ["db/epsg_proj.sqlite"],
    outs = ["db/crs_database.csv"],
    cmd = "$(location list_supported_crs) $< $@ $(location check_crs_support)",
    tools = [
        "check_crs_support",
        "list_supported_crs",
    ],
    visibility = ["//visibility:public"],
)
