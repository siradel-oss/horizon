    build_setting_default = "gl",
    values = [
        "gl",
        "gles",
    ],
)

config_setting(
    name = "linux_wsi_x11_gl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flag_values = {
        "//:linux_wsi": "x11",
        "//:gl_api": "gl",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_wsi_x11_gles",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flag_values = {
        "//:linux_wsi": "x11",
        "//:gl_api": "gles",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_wsi_headless_egl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flag_values = {
        "//:linux_wsi": "headless_egl",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "windows_wgl_gl",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    flag_values = {
        "//:gl_api": "gl",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "windows_egl_gles",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
