#
# GLSL toolchains
#

GLSL_EXEC_OS = [
    "windows",
    "linux",
]

GLSL_TARGETS = {
    "core": {
        "check_version": "330",
        "profile": "core",
        "cpu": "x86_64",
    },
    "es": {
        "check_version": "310",  # glslangValidator only wants version >= 310 for validation
        "profile": "es",
        "cpu": "wasm32",
    },
}

[
    glsl_toolchain(
        name = "glslc_{}_{}".format(target, os),
        check_version = GLSL_TARGETS[target]["check_version"],
        profile = GLSL_TARGETS[target]["profile"],
        validator = "@glslang_{}//:glslangValidator".format(os),
    )
    for os in GLSL_EXEC_OS
    for target in GLSL_TARGETS
]

[
    toolchain(
        name = "glslc_{}_{}_toolchain".format(target, os),
        exec_compatible_with = [
            "@platforms//os:{}".format(os),
            "@platforms//cpu:x86_64",
        ],
        target_compatible_with = [
            "@platforms//cpu:{}".format(GLSL_TARGETS[target]["cpu"]),
        ],
        toolchain = ":glslc_{}_{}".format(target, os),
        toolchain_type = "//tools/bazel/glsl:toolchain_type",
    )
    for os in GLSL_EXEC_OS
    for target in GLSL_TARGETS
]

#
# CI
#

hrz_genrule(
