load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//tools/visual_testing/client:vite/package_json.bzl", vite_bin = "bin")
load("@npm//tools/visual_testing/client:vue-tsc/package_json.bzl", vue_tsc_bin = "bin")

npm_link_all_packages(name = "node_modules")

run_binary(
    name = "generate_schema_types",
    outs = ["src/proto/schema.ts"],
    args = ["$(location src/proto/schema.ts)"],
    tool = "//tools/visual_testing/protocol:generate_ts_types",
)

COMMON_DATA = glob([
    "src/**/*",
]) + [
    "package.json",
    "tsconfig.json",
    "//:tsconfig",
    "index.html",
    "vite.config.ts",
    ":node_modules",
    ":generate_schema_types",
]

vue_tsc_bin.vue_tsc(
    name = "type_check",
    srcs = COMMON_DATA,
    args = [
        "--noEmit",
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    stdout = "tsmarker.d.ts",
)

vite_bin.vite(
    name = "build",
    srcs = COMMON_DATA + [
        ":type_check",
    ],
    outs = [
        "dist/index.html",
    ],
    args = [
        "build",
    ],
    chdir = package_name(),
    out_dirs = ["dist/assets/"],
)

vite_bin.vite_binary(
    name = "vite",
    chdir = package_name(),
    data = COMMON_DATA,
    tags = ["ibazel_notify_changes"],
)
