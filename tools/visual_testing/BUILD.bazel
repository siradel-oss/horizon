load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")

cc_binary(
    name = "viewer",
    srcs = [
        "viewer.cpp",
    ],
    includes = ["."],
    linkopts = select({
        "//:os_linux": [
            "-pthread",
            "-Wl,-rpath,'$$ORIGIN'",
        ],
        "//conditions:default": [],
    }) + select({
        "//:linux_wsi_x11_gl": [
            "-lX11",
        ],
        "//:linux_wsi_headless_egl": [],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//hrz/branding:icons",
        "//hrz/core:hrz_core",
        "//hrz/cpp_api",
        "//hrz/fnd",
        "//hrz/protocol/history:scene_model_version",
        "//hrz/scene_dump:migration",
        "//hrz/version",
        "//libs/argparser",
        "//libs/wsi",
        "//third_party/stb_image_write",
    ],
)

cc_binary(
    name = "comparator",
    srcs = [
        "comparator.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/stb_image:stb_image_default_malloc",
        "//third_party/stb_image_write",
    ],
)

py_binary(
    name = "generate_html_visual_test_report",
    srcs = ["generate_html_visual_test_report.py"],
    data = [
        "report/index.tpl.html",
        "report/report.tpl.html",
        "//hrz/branding:favicon-128x128.png",
        "//hrz/branding:favicon-16x16.png",
        "//hrz/branding:favicon-32x32.png",
        "//hrz/branding:favicon-96x96.png",
    ],
    main = "generate_html_visual_test_report.py",
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//jinja2",
    ],
)

pkg_files(
    name = "kit_normal_files",
    srcs = [
        "README.md",
        "//:LICENSE",
        "//hrz/core:hrz_core_shared_lib",
        "//third_party:LICENSE-THIRD-PARTY.txt",
    ],
    attributes = pkg_attributes(mode = "0644"),
)

pkg_files(
    name = "kit_executable_files",
    srcs = [
        ":comparator",
        ":viewer",
        "//tools/scene_dump:migrate_dump",
    ],
    attributes = pkg_attributes(mode = "0755"),
)

pkg_tar(
    name = "kit",
    srcs = [
        ":kit_executable_files",
        ":kit_normal_files",
    ],
    extension = "tar.gz",
)
