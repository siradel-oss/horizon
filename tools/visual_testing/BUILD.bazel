load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:pkg.bzl", "pkg_tar_aggregate")

cc_binary(
    name = "viewer",
    srcs = [
        "viewer.cpp",
    ],
    includes = ["."],
    linkopts = select({
        "//:os_linux": [
            "-pthread",
            "-Wl,-rpath,'$$ORIGIN'",
        ],
        "//conditions:default": [],
    }) + select({
        "//:linux_wsi_x11_gl": [
            "-lX11",
        ],
        "//:linux_wsi_headless_egl": [],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//hrz/branding:icons",
        "//hrz/core:hrz_core",
        "//hrz/cpp_api:hrz_cpp_api",
        "//hrz/fnd:hrz_fnd",
        "//hrz/scene_dump:migration",
        "//libs/argparser",
        "//libs/wsi",
        "//third_party/stb_image_write",
    ],
)

cc_binary(
    name = "comparator",
    srcs = [
        "comparator.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/stb_image:stb_image_default_malloc",
        "//third_party/stb_image_write",
    ],
)

py_binary(
    name = "generate_html_visual_test_report",
    srcs = ["generate_html_visual_test_report.py"],
    data = [
        "report/index.tpl.html",
        "report/report.tpl.html",
        "//hrz/branding:favicon-128x128.png",
        "//hrz/branding:favicon-16x16.png",
        "//hrz/branding:favicon-32x32.png",
        "//hrz/branding:favicon-96x96.png",
    ],
    main = "generate_html_visual_test_report.py",
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//jinja2",
    ],
)

pkg_tar_aggregate(
    name = "kit",
    dirs = {
        "": [
            ":comparator",
            ":viewer",
            "//hrz/core:hrz_core_shared_lib",
            "//tools/scene_dump:migrate_dump",
            "//third_party:LICENSE-THIRD-PARTY.txt",
            "//:LICENSE",
            "README.md",
        ],
    },
    extension = "tar.gz",
)
