load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

cc_binary(
    name = "viewer",
    srcs = [
        "viewer.cpp",
    ],
    includes = ["."],
    linkopts = select({
        "@platforms//os:linux": [
            "-pthread",
            "-Wl,-rpath,'$$ORIGIN'",
        ],
        "//conditions:default": [],
    }) + select({
        "//:linux_windowed": [
            "-lX11",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//hrz/core:hrz_core",
        "//hrz/cpp_api",
        "//hrz/fnd",
        "//hrz/protocol/history:scene_model_version",
        "//hrz/scene_dump:migration",
        "//hrz/version",
        "//libs/argparser",
        "//libs/wsi",
        "//third_party/stb_image_write",
    ],
)

cc_binary(
    name = "comparator",
    srcs = [
        "comparator.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/stb_image:stb_image_default_malloc",
        "//third_party/stb_image_write",
    ],
)

pkg_files(
    name = "kit_normal_files",
    srcs = [
        "README.md",
        "//:LICENSE",
        "//hrz/core:hrz_core_shared_lib",
        "//third_party:LICENSE-THIRD-PARTY.txt",
    ],
    attributes = pkg_attributes(mode = "0644"),
)

pkg_files(
    name = "kit_executable_files",
    srcs = [
        ":comparator",
        ":viewer",
        "//tools/scene_dump:migrate_dump",
    ],
    attributes = pkg_attributes(mode = "0755"),
)

pkg_tar(
    name = "kit",
    srcs = [
        ":kit_executable_files",
        ":kit_normal_files",
    ],
    extension = "tar.gz",
)
