load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@rules_cc//cc/toolchains:tool.bzl", "cc_tool")
load("@rules_cc//cc/toolchains:tool_map.bzl", "cc_tool_map")
load("@rules_cc//cc/toolchains:toolchain.bzl", "cc_toolchain")
load("@sniper_includes//:includes.bzl", "CHROOT_INCLUDES")

package(default_visibility = ["//visibility:public"])

exports_files(["wrappers/proot_run"])

cc_tool(
    name = "gcc_tool",
    src = "wrappers/gcc",
    allowlist_include_directories = CHROOT_INCLUDES,
    data = ["wrappers/proot_run"],
    tags = ["manual"],
)

cc_tool(
    name = "gxx_tool",
    src = "wrappers/g++",
    allowlist_include_directories = CHROOT_INCLUDES,
    data = ["wrappers/proot_run"],
    tags = ["manual"],
)

cc_tool(
    name = "ar_tool",
    src = "wrappers/ar",
    data = ["wrappers/proot_run"],
    tags = ["manual"],
)

cc_tool(
    name = "ld_tool",
    src = "wrappers/ld",
    data = ["wrappers/proot_run"],
    tags = ["manual"],
)

cc_tool(
    name = "objcopy_tool",
    src = "wrappers/objcopy",
    data = ["wrappers/proot_run"],
    tags = ["manual"],
)

cc_tool(
    name = "strip_tool",
    src = "wrappers/strip",
    data = ["wrappers/proot_run"],
    tags = ["manual"],
)

cc_tool_map(
    name = "all_tools",
    tags = ["manual"],
    tools = {
        "@rules_cc//cc/toolchains/actions:ar_actions": ":ar_tool",
        "@rules_cc//cc/toolchains/actions:assembly_actions": ":gcc_tool",
        "@rules_cc//cc/toolchains/actions:c_compile": ":gcc_tool",
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions": ":gxx_tool",
        "@rules_cc//cc/toolchains/actions:link_actions": ":ld_tool",
        "@rules_cc//cc/toolchains/actions:objcopy_embed_data": ":objcopy_tool",
        "@rules_cc//cc/toolchains/actions:strip": ":strip_tool",
    },
)

# experimental_replace_legacy_action_config_features only provides the plumbing
# (includes, defines, outputs, libraries, user copts/linkopts...), and the
# opt/dbg features from rules_cc are empty placeholders meant to be overridden.
# The flags below mirror the defaults of rules_cc's unix_cc_configure.bzl so
# that sniper builds match the normal Linux build.

cc_args(
    name = "default_compile_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fstack-protector",
        "-Wall",
        "-Wunused-but-set-parameter",
        "-Wno-free-nonheap-object",
        "-fno-omit-frame-pointer",
        "-fno-canonical-system-headers",
        "-Wno-builtin-macro-redefined",
        "-D__DATE__=\"redacted\"",
        "-D__TIMESTAMP__=\"redacted\"",
        "-D__TIME__=\"redacted\"",
    ],
    tags = ["manual"],
)

cc_args(
    name = "default_link_flags",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-Wl,-z,relro,-z,now",
        "-pass-exit-codes",
    ],
    tags = ["manual"],
)

cc_args(
    name = "opt_compile_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-g0",
        "-O2",
        "-D_FORTIFY_SOURCE=1",
        "-DNDEBUG",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    tags = ["manual"],
)

cc_args(
    name = "opt_link_flags",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-Wl,--gc-sections"],
    tags = ["manual"],
)

cc_feature(
    name = "opt_feature",
    args = [
        ":opt_compile_flags",
        ":opt_link_flags",
    ],
    overrides = "@rules_cc//cc/toolchains/features:opt",
    tags = ["manual"],
)

cc_args(
    name = "dbg_compile_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-g"],
    tags = ["manual"],
)

cc_feature(
    name = "dbg_feature",
    args = [":dbg_compile_flags"],
    overrides = "@rules_cc//cc/toolchains/features:dbg",
    tags = ["manual"],
)

cc_toolchain(
    name = "sniper_cc_toolchain",
    args = [
        ":default_compile_flags",
        ":default_link_flags",
    ],
    compiler = "gcc",
    enabled_features = ["@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features"],
    known_features = [
        "@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features",
        ":dbg_feature",
        ":opt_feature",
    ],
    tags = ["manual"],
    tool_map = ":all_tools",
)

toolchain(
    name = "sniper_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = ["//:sniper_constraint"],
    toolchain = ":sniper_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
