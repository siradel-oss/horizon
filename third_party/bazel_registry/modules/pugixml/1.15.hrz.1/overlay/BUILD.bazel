""" Builds pugixml.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "pugixml",
    srcs = ["src/pugixml.cpp"],
    hdrs = [
        "src/pugiconfig.hpp",
        "src/pugixml.hpp",
    ],
    defines = [
        "PUGIXML_NO_EXCEPTIONS",
    ],
    includes = ["src"],
    visibility = ["//visibility:public"],
)

exports_files(["LICENSE.md"], visibility = ["//visibility:public"])
