config_setting(
    name = "debug",
    values = {
        "compilation_mode": "dbg",
    }
)

config_setting(
    name = "fast",
    values = {
        "compilation_mode": "fastbuild",
    }
)

config_setting(
    name = "release",
    values = {
        "compilation_mode": "opt",
    }
)

cc_library(
    name = "headers",
    hdrs = glob(["include/draco/**/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "libdraco_l",
    static_library = select({
        "debug":   "lib/Debug/draco.lib",
        "release": "lib/Release/draco.lib",
        "fast":    "lib/Release/draco.lib",
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "draco",
    deps = [
        "headers",
        "libdraco_l",
    ],
    visibility = ["//visibility:public"],
)
