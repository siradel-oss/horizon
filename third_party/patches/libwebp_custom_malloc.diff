+extern void* webp_calloc(size_t, size_t);
+extern void webp_free(void*);
+
 // This is the maximum memory amount that libwebp will ever try to allocate.
 #ifndef WEBP_MAX_ALLOCABLE_MEMORY
 #if SIZE_MAX > (1ULL << 34)
