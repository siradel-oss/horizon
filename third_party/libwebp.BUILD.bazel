package(default_visibility = ["//visibility:public"])

cc_library(
    name = "libwebp",
    hdrs = [
        "src/webp/decode.h",
    ],
    srcs = glob([
        "src/dsp/*.c",
        "src/dsp/*.h",
        "src/utils/*.c",
        "src/utils/*.h",
        "src/dec/*.c",
        "src/dec/*.h",
        "src/demux/*.c",
        #"src/demux/*.h",
        #"src/enc/*.c",
        "src/enc/*.h",
        "src/webp/*.h",
    ]),
    defines = [
        "WEBP_EXTERN=",
    ] + select({
        "@//:os_native": [
            "WEBP_ENABLE_SIMD",
            "WEBP_USE_THREAD",
        ],
        "//conditions:default": [],
    }),
    includes = [
        "src",
    ],
)
