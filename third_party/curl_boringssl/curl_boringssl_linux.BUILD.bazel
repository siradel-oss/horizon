config_setting(
    name = "debug",
    values = {
        "compilation_mode": "dbg",
    }
)

config_setting(
    name = "fast",
    values = {
        "compilation_mode": "fastbuild",
    }
)

config_setting(
    name = "release",
    values = {
        "compilation_mode": "opt",
    }
)

cc_library(
    name = "headers",
    hdrs = glob(["include/curl/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "curl_l",
    static_library = select({
        "debug": "lib/dbg/libcurl.a",
        "fast": "lib/opt/libcurl.a",
        "release": "lib/opt/libcurl.a",
    }),
    visibility = ["//visibility:public"],
)

cc_import(
    name = "crypto_l",
    static_library = select({
        "debug": "lib/dbg/libcrypto.a",
        "fast": "lib/opt/libcrypto.a",
        "release": "lib/opt/libcrypto.a",
    }),
    visibility = ["//visibility:public"],
)

cc_import(
    name = "ssl_l",
    static_library = select({
        "debug": "lib/dbg/libssl.a",
        "fast": "lib/opt/libssl.a",
        "release": "lib/opt/libssl.a",
    }),
    deps = [
        ":crypto_l",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "crypto",
    deps = [
        "crypto_l",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ssl",
    deps = [
        "ssl_l",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "curl",
    deps = [
        "headers",
        "curl_l",
        "crypto",
        "ssl",
        "@horizon//third_party:zlib",
    ],
    defines = [
        "CURL_STATICLIB=1",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    srcs = ["cacert.pem"],
)
