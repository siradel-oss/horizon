package(default_visibility = ["//visibility:public"])

alias(
    name = "protoc",
    actual = select({
        "@platforms//os:windows": "@@protobuf++protoc+prebuilt_protoc.win64//:bin/protoc.exe",
        "@platforms//os:linux": "@@protobuf++protoc+prebuilt_protoc.linux_x86_64//:bin/protoc",
    }),
)

alias(
    name = "buildifier",
    actual = select({
        "@platforms//os:windows": "@buildifier_windows//file:downloaded",
        "@platforms//os:linux": "@buildifier_linux//file:downloaded",
    }),
)

