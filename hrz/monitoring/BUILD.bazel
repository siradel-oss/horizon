load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

filegroup(
    name = "proto",
    srcs = ["interface.proto"],
    visibility = ["//visibility:public"],
)

run_binary(
    name = "generate_proto",
    srcs = [
        "interface.proto",
    ],
    outs = [
        "interface.pb.cc",
        "interface.pb.h",
    ],
    args = [
        "$(location interface.proto)",
        "--cpp_out=$(BINDIR)",
    ],
    tool = "//third_party:protoc",
)

cc_library(
    name = "monitoring",
    srcs = [
        "interface.pb.cc",
        "monitoring.cpp",
    ],
    hdrs = [
        "interface.pb.h",
        "monitoring.h",
        "protocol.h",
    ],
    # Windows still has issues with generated files in the same location as
    # regular files, so we need to isolate them using an include prefix.
    include_prefix = package_name(),
    visibility = ["//visibility:public"],
    deps = [
        "//hrz/fnd",
        "@protobuf//:protobuf_lite",
    ],
)

cc_test(
    name = "tests",
    testonly = False,
    srcs = [
        "tests/monitoring.cpp",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        ":monitoring",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
