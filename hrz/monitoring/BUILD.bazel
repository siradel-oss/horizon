load("//tools/bazel:genrule.bzl", "hrz_genrule")

filegroup(
    name = "proto",
    srcs = ["interface.proto"],
    visibility = ["//visibility:public"],
)

hrz_genrule(
    name = "generate_proto",
    srcs = [
        "interface.proto",
    ],
    outs = [
        "interface.pb.cc",
        "interface.pb.h",
    ],
    cmd = "$(location //third_party:protoc) $(location interface.proto) --cpp_out=$(BINDIR)",
    tools = [
        "//third_party:protoc",
    ],
)

cc_library(
    name = "monitoring",
    srcs = [
        "interface.pb.cc",
        "monitoring.cpp",
    ],
    hdrs = [
        "interface.pb.h",
        "monitoring.h",
        "protocol.h",
    ],
    # Windows still has issues with generated files in the same location as
    # regular files, so we need to isolate them using an include prefix.
    include_prefix = package_name(),
    visibility = ["//visibility:public"],
    deps = [
        "//hrz/fnd",
        "//third_party:libprotobuf-lite",
    ],
)

cc_test(
    name = "tests",
    testonly = False,
    srcs = [
        "tests/monitoring.cpp",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        ":monitoring",
        "//third_party:gtest",
        "//third_party:gtest_main",
    ],
)
