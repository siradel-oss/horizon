{
  "version": 8,
  "metadata": {
    "hrz:fonts": {
      "Roboto Regular": "https://hrz.siradel.com/assets/fonts/Roboto/Roboto-Regular.ttf"
    },
    "maputnik:renderer": "mbgljs"
  },
  "center": [-1.67945, 48.11139],
  "zoom": 17,
  "pitch": 20,
  "sources": {
    "grid": {
      "type": "geojson",
      "data": "https://hrz.siradel.com/assets/geojson/grid_10x10.geojson"
    }
  },
  "sprite": "https://hrz.siradel.com/assets/sprites/sprites_mapbox/stretch_tests",
  "glyphs": "https://hrz.siradel.com/assets/fonts/fonts_mapbox/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "sprites",
      "type": "symbol",
      "source": "grid",
      "filter": [
        "any",
        ["==", ["get", "x"], 3],
        ["==", ["get", "x"], 6],
        ["match", ["get", "y"], [3, 6], true, false]
      ],
      "paint": {
        "icon-translate": ["literal", [2, 2]],
        "icon-translate-anchor": "viewport",
        "text-color": "rgba(255, 84, 84, 1)",
        "text-halo-color": "rgba(138, 35, 119, 1)",
        "text-halo-width": 1.5,
        "text-translate": ["literal", [2, 2]],
        "text-translate-anchor": "viewport"
      },
      "layout": {
        "text-field": [
          "format",
          ["to-string", ["get", "x"]],
          {},
          ["to-string", ["get", "y"]]
        ],
        "text-font": ["literal", ["Roboto Regular"]],
        "icon-allow-overlap": true,
        "icon-ignore-placement": true,
        "text-allow-overlap": true,
        "text-ignore-placement": true,
        "text-size": 16,
        "icon-image": "panneau_content_stretch",
        "icon-text-fit": "both"
      }
    }
  ],
  "id": "zmb2hgpsz"
}
