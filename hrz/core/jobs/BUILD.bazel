load("//tools/bazel:genrule.bzl", "hrz_genrule")

hrz_genrule(
    name = "generate_proto",
    srcs = [
        "proto/geobuf.proto",
        "proto/hrz_jobs.proto",
        "proto/vector_tile.proto",
        "//hrz/proto:protos",
    ],
    outs = [
        "proto/geobuf.pb.cc",
        "proto/geobuf.pb.h",
        "proto/hrz_jobs.pb.cc",
        "proto/hrz_jobs.pb.h",
        "proto/vector_tile.pb.cc",
        "proto/vector_tile.pb.h",
    ],
    cmd = "$(location //third_party:protoc) -Ihrz/proto -Ihrz/core/jobs/proto hrz/core/jobs/proto/hrz_jobs.proto hrz/core/jobs/proto/vector_tile.proto hrz/core/jobs/proto/geobuf.proto --cpp_out=$(@D)/proto",
    tools = [
        "//third_party:protoc",
    ],
)

cc_library(
    name = "proto",
    srcs = [
        "proto/geobuf.pb.cc",
        "proto/geobuf.pb.h",
        "proto/hrz_jobs.pb.cc",
        "proto/hrz_jobs.pb.h",
        "proto/vector_tile.pb.cc",
        "proto/vector_tile.pb.h",
    ],
    hdrs = [
        "include/hrz_jobs_enum_names.h",
        "include/hrz_jobs_protocol.h",
    ],
    includes = [
        "include",
        "proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//hrz/cpp_protocol:hrz_cpp_protocol",
        "//third_party:libprotobuf-lite",
    ],
)

hrz_genrule(
    name = "proto_xml_protocol",
    srcs = [
        "proto/geobuf.proto",
        "proto/hrz_jobs.proto",
        "proto/vector_tile.proto",
        "//hrz/proto:protos",
    ],
    outs = [
        "proto/hrz_protocol.xml",
    ],
    cmd = "$(execpath //third_party:protoc) -Ihrz/proto -Ihrz/core/jobs/proto hrz/core/jobs/proto/hrz_jobs.proto --plugin=protoc-gen-xml_desc=$(execpath //hrz/xml_desc_generator:xml_desc_generator) --xml_desc_out=$(@D)",
    tools = [
        "//hrz/xml_desc_generator",
        "//third_party:protoc",
    ],
)

hrz_genrule(
    name = "generate_templates",
    srcs = [
        ":proto/hrz_protocol.xml",
        "//hrz/generators:job_declarations_tpl",
    ],
    outs = [
        "include/hrz_jobs_declarations.h",
        "include/hrz_jobs_enum_names.h",
        "include/hrz_jobs_tickets.h",
        "src/hrz_jobs_declarations.cpp",
        "src/hrz_jobs_tickets.cpp",
    ],
    cmd = "$(location //hrz/generators:generator) $(location :proto/hrz_protocol.xml) job_declarations $(@D)",
    tools = ["//hrz/generators:generator"],
)

filegroup(
    name = "declarations_hdrs",
    srcs = [
        "include/hrz_jobs_declarations.h",
    ],
)

filegroup(
    name = "declarations_srcs",
    srcs = [
        "src/hrz_jobs_declarations.cpp",
    ],
)

cc_library(
    name = "hrz_core_jobs",
    srcs = [
        "include/hrz_jobs_clipping.h",
        "include/hrz_jobs_context.h",
        "include/hrz_jobs_executor.h",
