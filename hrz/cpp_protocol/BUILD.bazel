load("//hrz/proto:list_proto_files.bzl", "list_proto_files")
load("//tools/bazel:genrule.bzl", "hrz_genrule")
load("//tools/bazel:pkg.bzl", "pkg_tar_aggregate")
load("//tools/bazel:utils.bzl", "make_dbg")

filegroup(
    name = "generated_hdrs",
    srcs = list_proto_files("", ".pb.h"),
)

filegroup(
    name = "generated_srcs",
    srcs = list_proto_files("", ".pb.cc"),
)

hrz_genrule(
    name = "generate_proto",
    srcs = [
        "//hrz/proto:protos",
    ],
    outs =
        list_proto_files("", ".pb.cc") +
        list_proto_files("", ".pb.h"),
    cmd = "$(location //third_party:protoc) -Ihrz/proto $(SRCS) --plugin=protoc-gen-hrz=$(execpath //hrz/cpp_protocol/protoc_plugin) --cpp_out=$(@D) --hrz_out=$(@D)",
    tools = [
        "//hrz/cpp_protocol/protoc_plugin",
        "//hrz/proto:protos",
        "//third_party:protoc",
    ],
)

hrz_genrule(
    name = "generate_templates",
    srcs = [
        "//hrz:hrz_protocol.xml",
        "//hrz/generators:cpp_protocol_tpl",
    ],
    outs = [
        "hrz_protocol_all.h",
        "hrz_protocol_path_builder.h",
        "hrz_services.h",
    ],
    cmd = "$(location //hrz/generators:generator) $(location //hrz:hrz_protocol.xml) cpp_protocol $(@D)",
    tools = [
        "//hrz/generators:generator",
    ],
)

cc_library(
    name = "hrz_cpp_protocol",
    srcs = [
        ":generated_hdrs",
        ":generated_srcs",
    ],
    hdrs = [
        ":generate_templates",
    ],
    includes = [
        ".",
        "include",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "//third_party:libprotobuf-lite",
    ],
)

make_dbg(
    name = "hrz_cpp_protocol_dbg",
    cc_target = ":hrz_cpp_protocol",
)

pkg_tar_aggregate(
    name = "pkg",
    dirs = {
        "include": [
            ":generated_hdrs",
            ":generate_templates",
        ],
        "lib_release": [":hrz_cpp_protocol"],
        "lib_debug": [":hrz_cpp_protocol_dbg"],
        "": [
            "//:LICENSE",
        ],
    },
    extension = "tar.gz",
)
