load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@tsconfig_util//:defs.bzl", "TSCONFIG")
load("//tools/bazel:npm.bzl", "PACKAGE_JSON_HRZ_LICENSE", "PACKAGE_JSON_HRZ_VERSION", "package_json")
load("//tools/bazel:structured_files_copy.bzl", "structured_files_copy")
load("//tools/bazel:utils.bzl", "merge_dicts")

# I was forced to separate the Core web package into the ts_core folder because pnpm workspace rules expect
# the main package to be called the same name as the folder it is in. Hence the alias at the end.

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "ts_lib",
    srcs = [
        "src/backend.ts",
        "src/hrz_core.d.ts",
        "src/index.ts",
    ],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = merge_dicts(
        TSCONFIG,
        {
            "compilerOptions": {
                "lib": [
                    "ES2021",
                    "DOM",
                ],
                "declaration": True,
            },
        },
    ),
    deps = [
        ":node_modules/@siradel-oss/horizon-api",
        ":node_modules/@siradel-oss/horizon-protocol",
        "//:node_modules/long",
    ],
)

package_json(
    name = "package_json",
    out = "dist-root/package.json",
    base = ":package.json",
    license = PACKAGE_JSON_HRZ_LICENSE,
    version = PACKAGE_JSON_HRZ_VERSION,
)

structured_files_copy(
    name = "pkg_copy",
    files = {
        "dist": [
            ":ts_lib",
            ":ts_lib_types",
            "//hrz/core:hrz_core.js",
            "//hrz/core:hrz_core.wasm",
            "src/hrz_core.d.ts",
        ],
        "": [
            "//:LICENSE",
            "//third_party:LICENSE-THIRD-PARTY.txt",
            ":package_json",
        ],
    },
    output_dir = "dist_pkg",
)

npm_package(
    name = "npm_pkg",
    srcs = [
        ":pkg_copy",
    ],
    replace_prefixes = {
        "dist_pkg/": "",
    },
)

alias(
    name = "ts_core",
    actual = ":npm_pkg",
)
