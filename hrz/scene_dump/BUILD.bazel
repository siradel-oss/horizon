load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:genrule.bzl", "hrz_genrule")

py_binary(
    name = "gen",
    srcs = ["gen.py"],
    data = [
        "//hrz/protocol/history:versions_manifest.csv",
        "//hrz/scene_dump/templates:all",
    ],
    deps = [
        "//hrz/protocol/history:manifest",
        "@pypi//jinja2",
        "@rules_python//python/runfiles",
    ],
)

hrz_genrule(
    name = "generate_migrations_list",
    srcs = [
        "//hrz/protocol/history:versions_manifest.csv",
    ],
    outs = [
        "migrations_list.h",
    ],
    cmd = "$(location gen) -m $(location //hrz/protocol/history:versions_manifest.csv) gen-cpp-migrations-list $@",
    tools = [":gen"],
)

cc_library(
    name = "utils",
    srcs = [
        "utils.cpp",
    ],
    hdrs = [
        "utils.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party:libprotobuf",
        "//third_party:lz4",
    ],
)

cc_library(
    name = "migration",
    srcs = [
        "dynamic_message.h",
        "migration.cpp",
        "migrations.cpp",
        "migrations_list.h",
    ],
    hdrs = [
        "migration.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":utils",
        "//hrz/fnd",
        "//hrz/protocol/history:descriptor_sets_list",
        "//hrz/protocol/history:scene_model_version",
    ],
)
