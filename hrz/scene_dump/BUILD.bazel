load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:genrule.bzl", "hrz_genrule")

py_binary(
    name = "gen",
    srcs = ["gen.py"],
    data = [
        "//hrz/proto/history:versions_manifest.csv",
        "//hrz/scene_dump/templates:all",
    ],
    deps = [
        "//hrz/proto/history:manifest",
        "@pypi//jinja2",
        "@rules_python//python/runfiles",
    ],
)

hrz_genrule(
    name = "generate_migrations_list",
    srcs = [
        "//hrz/proto/history:versions_manifest.csv",
    ],
    outs = [
        "include/hrz_migrations_list.h",
    ],
    cmd = "$(location gen) -m $(location //hrz/proto/history:versions_manifest.csv) gen-cpp-migrations-list $@",
    tools = [":gen"],
)

cc_library(
    name = "utils",
    srcs = [
        "src/scene_dump_utils.cpp",
    ],
    hdrs = [
        "include/hrz_scene_dump_utils.h",
    ],
    includes = [
        "include",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party:gsl",
        "//third_party:libprotobuf",
        "//third_party:lz4",
    ],
)

cc_library(
    name = "migration",
    srcs = [
        "include/dynamic_message.h",
        "include/hrz_migrations_list.h",
        "src/migration.cpp",
        "src/migrations.cpp",
    ],
    hdrs = [
        "include/hrz_migration.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":utils",
        "//hrz/proto/history:hrz_descriptor_sets_list",
        "//hrz/proto/history:hrz_scene_model_version",
    ],
)
